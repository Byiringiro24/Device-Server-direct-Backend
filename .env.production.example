# Production Environment Variables
# Use this configuration on your production server

# Database Configuration
# Use localhost if database is on the same server, or use the IP if remote
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
# DATABASE_URL="postgresql://postgres:2211@13.140.133.61:5432/ecareafrica?schema=public"

# JWT Configuration
JWT_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-secret
PLATFORM_JWT_SECRET=replace-with-long-random-secret
PLATFORM_JWT_REFRESH_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d

# Server Configuration
PORT=5500
NODE_ENV=production
TZ=Africa/Kampala

# IMPORTANT: CORS Configuration for Production
# This allows your frontend domain to access the API
CORS_ORIGIN=https://ecareafrica.net,https://www.ecareafrica.net

# Rate Limiting (recommended for production)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CRITICAL: Enable trust proxy if behind nginx/load balancer
TRUST_PROXY=true

# S3 Storage Configuration (Cloudflare R2)
S3_ENDPOINT=https://abcd1234efgh.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=ecareafrica-storage
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret-key
S3_PUBLIC_URL=https://pub.r2.dev

# SMTP Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=netrackdevelopement@gmail.com

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Uganda SMS Provider Configuration
# These values are used by the attendance and notification SMS flow for Ugandan schools.
SMS_UGANDA_API_URL=http://text.emediauganda.com/api.php
SMS_UGANDA_USER=replace-with-sms-username
SMS_UGANDA_PASSWORD=replace-with-sms-password
SMS_UGANDA_SENDER=EducationCare

# Application Base URL
APP_BASE_URL=https://ecareafrica.net



# FK WAN direct Device-Server (keep this API private to the ECA backend)
FK_DEVICE_SERVER_URL=http://127.0.0.1:8005
# Optional legacy fallback only; prefer setting this in Super Admin > Direct FK Devices.
# FK_DEVICE_SERVER_TOKEN=
FK_DEVICE_SERVER_TIMEOUT_MS=8000
FK_DEVICE_COMMAND_TIMEOUT_MS=90000
FK_DEVICE_SYNC_INTERVAL_MS=15000
